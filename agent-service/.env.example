# --- AgentRouter (LLM) ---
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=sk-your-key-here
AGENTROUTER_MODEL=gpt-5.6-sol
# REQUIRED by agentrouter.org or requests are rejected with 403
AGENTROUTER_USER_AGENT=opencode/1.0.0

# --- Go bridge ---
BRIDGE_API_URL=http://127.0.0.1:8080/api
# Leave empty to auto-read the token from BRIDGE_TOKEN_FILE (default points at
# the whatsapp-mcp clone next to this project)
BRIDGE_TOKEN=
BRIDGE_TOKEN_FILE=../whatsapp-mcp/whatsapp-bridge/store/.bridge-token

# Local message archive written by the bridge (read-only access for analysis)
MESSAGES_DB_PATH=../whatsapp-mcp/whatsapp-bridge/store/messages.db

# --- Agent service ---
AGENT_DB_PATH=./data/agent.db
# Bearer token callers must present. Empty = generated at startup and written
# to AGENT_TOKEN_FILE with owner-only permissions (mirrors the bridge pattern).
AGENT_SERVICE_TOKEN=
AGENT_TOKEN_FILE=./data/.agent-token

# Approval workflow
PENDING_ACTION_TTL_SECONDS=300

# Latency observability (warn-log threshold per request, ms)
LATENCY_WARN_MS=2000

# LLM call tuning
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=2
LLM_MAX_TOOL_ROUNDS=6

# --- Live events (bridge -> agent SSE bus) ---
# The Go bridge pushes inbound messages to the agent's webhook so the UI
# updates in realtime without browser polling.
WEBHOOK_ENABLED=true
WEBHOOK_URL=http://127.0.0.1:8100/internal/webhook

# --- Voice Agent TTS (optional: falls back to browser speech if unset) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5
VOICE_WAKE_GREETING=Hello! How can I help with WhatsApp today?
