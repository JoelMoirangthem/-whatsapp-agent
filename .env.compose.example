# Root-level compose configuration for `docker compose up`
# (copy to .env beside docker-compose.yml)

# --- LLM ---
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_API_KEY=sk-your-key-here
AGENTROUTER_MODEL=gpt-5.6-sol
AGENTROUTER_USER_AGENT=opencode/1.0.0

# Generate long random values, e.g.: openssl rand -hex 32
WHATSAPP_BRIDGE_TOKEN=change-me-long-random
AGENT_SERVICE_TOKEN=change-me-long-random

# --- Bridge behavior ---
FORWARD_SELF=false
WEBHOOK_ENABLED=true
WEBHOOK_URL=http://agent:8100/internal/webhook
WHATSAPP_DELETE_MAX_AGE_HOURS=48

# --- Agent service ---
PENDING_ACTION_TTL_SECONDS=300
LATENCY_WARN_MS=2000

# --- Voice Agent (optional: browser TTS fallback when empty) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5
VOICE_WAKE_GREETING=Hello! How can I help with WhatsApp today?
